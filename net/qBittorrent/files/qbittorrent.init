#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/bin/qbittorrent-nox

start_service() {
	local enabled http_port download_dir profile_dir config_file escaped_download_dir

	config_load qbittorrent
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get http_port config http_port 8080
	config_get download_dir config download_dir /mnt/download
	config_get profile_dir config profile_dir /etc/qbittorrent
	config_file="$profile_dir/qBittorrent/config/qBittorrent.conf"

	mkdir -p "$profile_dir/qBittorrent/config" "$download_dir" /var/log/qbittorrent || return 1

	if [ ! -f "$config_file" ]; then
		cp /usr/share/qbittorrent/qBittorrent.conf.example "$config_file" || return 1
	fi

	escaped_download_dir="$(printf '%s' "$download_dir" | sed 's/[\\&|]/\\&/g')"
	sed -i 's|^Session\\DefaultSavePath=.*|Session\\DefaultSavePath='"$escaped_download_dir"'|' "$config_file"

	procd_open_instance instance1
	procd_set_param command "$PROG"
	procd_append_param command "--webui-port=$http_port" "--profile=$profile_dir"
	procd_set_param respawn
	procd_set_param file "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger qbittorrent
}

reload_service() {
	stop
	sleep 1
	start
}
